# Written by `buildrules init`. buildrules is the cell `buildrules`; the cell name is
# part of every output path, so it is not renamed. Where actions run is NOT here: a
# remote-execution endpoint lives in .buckconfig.local (gitignored); see
# .buckconfig.local.example.

[cells]
  tierstore = .
  prelude = prelude
  toolchains = toolchains
  none = none
  # A git external cell needs no directory; nothing is checked out at this path.
  buildrules = buildrules-ext

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[external_cells]
  prelude = bundled
  buildrules = git

[external_cell_buildrules]
  git_origin = https://github.com/komira-ai/buildrules
  commit_hash = a693e5c34b3100e01e3d2c66d22359d080163333

# The farm's linux x86_64 worker property set, for buildrules, which reads it from this (the root)
# cell. In CI, komira's farm-connect action (.github/workflows/farm.yml) writes it under
# [komira_re] in ~/.buckconfig.d/farm.buckconfig, which buck2 reads too; this key follows it and
# holds no value of its own, so this public file names no worker. A machine with its own
# .buckconfig.local sets the key there, which wins. With neither, the value is empty and the
# execution platform fails to load, naming the key: nothing falls back to this machine.
[buildrules_re]
  linux_x86_64_properties = $(config komira_re.linux_x86_64_properties)

# Batches of blobs to the farm's store stay under 1 MiB each, as in buildrules' own .buckconfig.
[buck2_re_client]
  max_total_batch_size = 1048576

[buildfile]
  name = BUCK

[parser]
  target_platform_detector_spec = target:tierstore//...->buildrules//platforms:linux_x86_64 target:toolchains//...->buildrules//platforms:linux_x86_64 target:buildrules//...->buildrules//platforms:linux_x86_64

[build]
  execution_platforms = tierstore//platforms:exec

[buck2]
  materializations = deferred
  sqlite_materializer_state = true
  defer_write_actions = true

[http]
  connect_timeout_ms = 30000
  read_timeout_ms = 120000

[project]
  ignore = buck-out, .git
