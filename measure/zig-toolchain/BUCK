# The Zig toolchain measurement: the writer and the reader of README.md, their unit tests, their coverage and the two actions that measure.
load("@buildrules//rules/core:platform.bzl", "MACOS_AARCH64")
load("@buildrules//rules/coverage:zig_cover.bzl", "zig_coverage")
load("@buildrules//rules/zig:zig.bzl", "zig_exe", "zig_test")
load(":defs.bzl", "tree_read", "tree_write")

zig_test(
    name = "tree_copy_unit",
    src = "tree_copy_test.zig",
    imports = ["tree_copy.zig"],
)

zig_test(
    name = "tree_read_unit",
    src = "tree_read_test.zig",
    imports = ["tree_read.zig"],
)

# The line coverage of the two programs (the 0.12 zig has no block counters, so no branch figure; rules/coverage/README.md). The two
# main files are not counted: each only hands its arguments to the file it imports, and no test can run a process's `main`.
zig_coverage(
    test_targets = [":tree_copy_unit", ":tree_read_unit"],
    expect = ["measure/zig-toolchain/tree_copy.zig", "measure/zig-toolchain/tree_read.zig"],
    blocks = False,
)

zig_exe(
    name = "tree_copy",
    src = "tree_copy_main.zig",
    imports = ["tree_copy.zig"],
    unit_tests = [":tree_copy_unit"],
)

zig_exe(
    name = "tree_read_exe",
    src = "tree_read_main.zig",
    imports = ["tree_read.zig"],
    unit_tests = [":tree_read_unit"],
)

# The writer: an action whose output directory is the Zig 0.12.0 toolchain, the tree buildrules unpacks from the pinned release
# archive. `-c ts_zig.write_nonce=<n>` makes it run again; `-c ts_zig.salt=<s>` gives each file new bytes (README.md, "The salt").
tree_write(
    name = "zig_tree",
    src = "buildrules//rules/pins:zig",
    tool = ":tree_copy",
    out = "zig",
    nonce = read_config("ts_zig", "write_nonce", ""),
    salt = read_config("ts_zig", "salt", ""),
)

# The reader: an action whose input is the writer's output; `-c ts_zig.read_nonce=<n>` makes it run again on the same tree.
tree_read(
    name = "zig_tree_read",
    tree = ":zig_tree",
    tool = ":tree_read_exe",
    nonce = read_config("ts_zig", "read_nonce", ""),
)

# The same two actions on a farm Mac (README.md, "On a Mac"): the programs built for macOS arm64, each action on the Mac execution
# platform, which exists only where `[buildrules_re] macos_aarch64_properties` is set. The tree written is the same toolchain.
zig_exe(
    name = "tree_copy_macos",
    src = "tree_copy_main.zig",
    imports = ["tree_copy.zig"],
    target = "aarch64-macos",
    unit_tests = [":tree_copy_unit"],
)

zig_exe(
    name = "tree_read_exe_macos",
    src = "tree_read_main.zig",
    imports = ["tree_read.zig"],
    target = "aarch64-macos",
    unit_tests = [":tree_read_unit"],
)

tree_write(
    name = "zig_tree_macos",
    src = "buildrules//rules/pins:zig",
    tool = ":tree_copy_macos",
    out = "zig",
    nonce = read_config("ts_zig", "write_nonce", ""),
    salt = read_config("ts_zig", "salt", ""),
    exec_compatible_with = MACOS_AARCH64,
)

tree_read(
    name = "zig_tree_read_macos",
    tree = ":zig_tree_macos",
    tool = ":tree_read_exe_macos",
    nonce = read_config("ts_zig", "read_nonce", ""),
    exec_compatible_with = MACOS_AARCH64,
)
