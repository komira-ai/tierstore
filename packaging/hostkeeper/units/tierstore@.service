# tierstore (crates/tierstore) as one of the two instances of the update hook on Linux: the
# template of tierstore@a.service and tierstore@b.service, installed by hostkeeper's package of
# tierstore. %i is the instance's letter. Both run /usr/local/libexec/tierstore/tierstore, both
# serve port 9300, and the update hook (`tierstore update-hook`, crates/tierstore/docs/update-hook.md)
# alternates between them: an update starts the idle one, which takes the listening sockets of the
# live one over the hand-over socket, and the live one drains and exits 0, which this unit does
# not restart (Restart=on-failure).
#
# The binary is not run from the package: hostkeeper keeps the package directories, and with them
# the release link `current`, closed to every user but root, and the instance runs as the account
# tierstore. The update hook, which runs as root, copies the binary of the release `current` names
# to /usr/local/libexec/tierstore/tierstore (root's, mode 0755, in directories that are root's and
# that no other user can write) before it starts an instance: in cutover the staged
# release's, in rollback the previous release's, at boot (restore) the current release's. The copy
# replaces the old one by a rename, so an instance that runs the old copy keeps it until it exits.
#
# An instance starts only when its marker file, /var/lib/tierstore/run-%i, exists
# (ConditionPathExists= below). The hook writes the marker before it starts the instance and
# removes it when it retires the instance, so at boot, when both units are enabled, only the one
# the hook's record names starts. A skipped condition is not a failure: the unit stays inactive.
#
# The hand-over socket lives in the StateDirectory: systemd sets STATE_DIRECTORY for it, and a
# process that has it and a configuration without `server.handoff_socket` uses
# /var/lib/tierstore/handoff.sock, so the file need not name it. With `mode = "restart"` in the
# package's params, or with a directory as the hot tier, an update stops the live instance before
# it starts the other, with a gap in serving.
#
# The unit is the one unit of docs/design/one-service.md (section 1.4): what the file system needs
# to make and keep a FUSE mount is given to it, and every option that gives a service a mount
# namespace of its own, from which a mount would not reach the host, is left out (section 2.2):
# PrivateDevices, ProtectSystem, ProtectHome, PrivateTmp, ProtectKernelTunables,
# ProtectKernelModules, ProtectKernelLogs, ProtectControlGroups, PrivateMounts, and the path
# options (ReadWritePaths= and the like). Without ProtectSystem= the process writes where its
# account may, and no path has to be made writable; a drop-in of the host's that adds a path
# option gives the service a mount namespace again. In their place: DevicePolicy=closed with
# DeviceAllow=/dev/fuse (a device filter, with no namespace: the standard pseudo devices and
# /dev/fuse); CAP_SYS_ADMIN as the only capability, bounding and ambient (the mount); the system
# calls of @mount, and pidfd_open and pidfd_getfd (a descriptor the service manager passes is
# taken as an owned duplicate, with no unsafe code); a descriptor store of one, kept across a
# restart (FileDescriptorStoreMax=1, FileDescriptorStorePreserve=restart); the runtime
# directories /run/tierstore-fs and /run/tierstore, kept across restarts; and the file system's
# restart values, 2 s and a start limit of 5 in 60 s, after which the unit is left failed.
# RestrictNamespaces=yes stays: it is a system-call filter, not a namespace, and the process makes
# no namespace. The process says nothing to the service manager when it serves, so the unit is
# Type=simple. tierstore-fs@.service, the unit of `tierstore fs`, leaves out the same options.
#
# The drain is the defaults of `server.drain_lb_wait` (10 s) and `server.drain_deadline` (15 m),
# which TimeoutStopSec= is above; the unit passes no flag for it.
#
# hostkeeper's own Force, which starts every `run` unit and waits for all of them, finds the
# standby instance inactive by design and reports it; the service is up all the same.
#
# /etc/tierstore/config.toml (the example is packaging/config.toml) is edited before use; its key
# files are owned by the account of User=, mode 0600, and the keys of the file that name them are
# the only way the process is given a secret (it reads no environment variable).
#
# The nft guard, when the host has one, is loaded before an instance starts: the unit
# tierstore-guard.service (packaging/tierstore-guard.service, which the deb and rpm packages
# install; a host of the archive package places its own) is wanted and ordered before this one. A
# Wants= of a unit that is absent, or whose condition (/etc/tierstore/guard.nft) fails, does not
# stop the instance from starting, and a stop of this instance does not stop the guard, which the
# other instance of a hand-over still needs.
[Unit]
Description=tierstore instance %i, an S3 server over a hot and a cold tier
Documentation=https://github.com/komira-ai/tierstore/blob/main/packaging/README.md
After=network-online.target
Wants=network-online.target
After=tierstore-guard.service
Wants=tierstore-guard.service
ConditionPathExists=/var/lib/tierstore/run-%i
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=tierstore
StateDirectory=tierstore
StateDirectoryMode=0700
RuntimeDirectory=tierstore-fs tierstore
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/libexec/tierstore/tierstore \
  --config /etc/tierstore/config.toml
KillSignal=SIGTERM
TimeoutStopSec=960
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=2 3
# The same value as tierstore-fs@.service: this process serves the node's cache and the fill socket for the mount, whose jobs keep files of it open as long as they run.
LimitNOFILE=1048576
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN
DevicePolicy=closed
DeviceAllow=/dev/fuse rw
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount pidfd_open pidfd_getfd
FileDescriptorStoreMax=1
FileDescriptorStorePreserve=restart

[Install]
WantedBy=multi-user.target
