<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  /Library/LaunchDaemons/tierstore.plist: tierstore as a LaunchDaemon on a Mac, installed by
  hostkeeper's package of tierstore (hostkeeper links it from the package's units/). root:wheel,
  mode 0644. One job, which the update hook (`tierstore update-hook`,
  crates/tierstore/docs/update-hook.md) boots out and bootstraps by the label below; an update is
  a restart with a gap in serving. The label is the service name, `tierstore`: hostkeeper takes a
  package's job from units/<label>.plist and watches it by the label its manifest's run entry and
  the hook's `launchd_label` param name, so the file name, the label and both entries agree.

  The program is /usr/local/libexec/tierstore/tierstore, not the binary inside the package:
  hostkeeper keeps the package directories, and with them the release link `current`, closed to
  every user but root, and the job runs as _tierstore. The update hook, which runs as root, copies
  the binary of the release `current` names there (root's, mode 0755, in directories that are
  root's and that no other user can write) before it loads the job: in cutover the staged
  release's, in rollback the previous release's, at boot (restore) the current release's. The hook
  never moves the link.

  Configuration is the file, nothing else; the drain is the macOS defaults of the file's
  server.drain_lb_wait (1 s) and server.drain_deadline (60 s). The file holds no
  secret, only the paths of the key files, and no environment variable is set: the process reads
  none.

  launchd sends SIGTERM on bootout. The process drains: /readyz says 503 for the settle of the
  drain (server.drain_lb_wait, 1 s on macOS: on loopback there is no load balancer to wait for), then it stops
  accepting and waits for requests in flight for at most the drain's deadline (server.drain_deadline,
  60 s on macOS), and exits 0. ExitTimeOut (210 s) is the job's of docs/design/one-service.md
  (section 1.4): the 1 s and the 60 s of the drain, the 120 s at most of the unmount of the file
  system that follows it when the process serves one (four steps of at most 25 s and 5 s to collect
  a killed command), and a margin, so that launchd never sends SIGKILL to a drain or an unmount in
  progress. KeepAlive starts the process again whenever it exits while the job is loaded, at most
  once in ThrottleInterval (10 s: a hard NFS mount waits for its server, so the server comes back
  fast); a bootout unloads the job, so a stop is a stop. AbandonProcessGroup is not set, so
  launchd's kill of the job also kills a helper command the process left.

  crates/tierstore/tests/packaging_hostkeeper.rs parses this file and checks it against the hook
  and the binary.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>tierstore</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/tierstore/tierstore</string>
    <string>--config</string>
    <string>/usr/local/tierstore/etc/tierstore.toml</string>
  </array>
  <key>UserName</key>
  <string>_tierstore</string>
  <key>GroupName</key>
  <string>_tierstore</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>210</integer>
  <key>ProcessType</key>
  <string>Standard</string>
  <key>Umask</key>
  <integer>63</integer>
  <!-- The same value as tierstore-fs.plist: this process serves the node's cache and the fill socket for the mount, whose jobs keep files of it open as long as they run. -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>1048576</integer>
  </dict>
  <key>HardResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>1048576</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/usr/local/tierstore/log/tierstore.out.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/tierstore/log/tierstore.err.log</string>
</dict>
</plist>
