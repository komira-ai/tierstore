<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  /Library/LaunchDaemons/com.komira.tierstore.plist: tierstore as a LaunchDaemon on a Mac (macOS
  on Apple silicon). root:wheel, mode 0644. One instance, a build node: a read cache on local disk
  in front of the cold store (`[local_cache]` in tierstore.toml), on loopback only, for the
  processes of this Mac. The update hook (`tierstore update-hook`, the declaration in
  updater.d/tierstore.toml) stops and starts this job with `launchctl bootout` and
  `launchctl bootstrap system` and updates it by a plain restart: it points the link
  /usr/local/tierstore/current at the staged release, so the program below is always the binary of
  the release that link names.

  Configuration is the file and the two flags of the drain, nothing else: the file pins the
  address (127.0.0.1:9300) and the slot label the hook's probe reads, and holds no secret, only
  the paths of the key files. No environment variable is set: the process reads none.

  launchd sends SIGTERM on bootout. The process drains: /readyz says 503 for the settle of the
  drain (drain-lb-wait, 1 s: on loopback there is no load balancer to wait for), then it stops
  accepting and waits for requests in flight for at most the drain's deadline (drain-deadline,
  60 s), and exits 0. ExitTimeOut (90 s) is the 1 s, the 60 s and a margin, so that launchd
  never sends SIGKILL to a drain in progress. The hook gives launchctl bootout at most 120 s,
  more than ExitTimeOut, and then looks up to 30 times, a second apart, until launchd no longer
  has the job; only then does it move the link current. KeepAlive starts the process again whenever it exits
  while the job is loaded, at most once in ThrottleInterval (30 s, as the Linux unit's
  RestartSec=30); a bootout unloads the job, so a stop is a stop.

  crates/tierstore/tests/packaging_macos.rs parses this file and checks it against the hook and
  the binary.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.komira.tierstore</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/tierstore/current/tierstore</string>
    <string>--config</string>
    <string>/usr/local/tierstore/etc/tierstore.toml</string>
    <string>--drain-lb-wait</string>
    <string>1s</string>
    <string>--drain-deadline</string>
    <string>60s</string>
  </array>
  <key>UserName</key>
  <string>_tierstore</string>
  <key>GroupName</key>
  <string>_tierstore</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ExitTimeOut</key>
  <integer>90</integer>
  <key>ProcessType</key>
  <string>Standard</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>65536</integer>
  </dict>
  <key>HardResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>65536</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/usr/local/tierstore/log/tierstore.out.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/tierstore/log/tierstore.err.log</string>
</dict>
</plist>
