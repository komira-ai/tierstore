# tierstore (crates/tierstore): an S3 server over a hot and a cold tier of S3-compatible stores.
# New objects are written to the hot tier, copied to the cold one in the background, and freed
# from the hot one when it fills.
#
# An example, not a package: nothing installs or enables it. The binary is the release asset
# tierstore-<commit>-<platform>.tar.gz (docs/artifacts.md), placed by digest at the path of
# ExecStart= (README.md says how). The unit has no [Install] section, so placing it starts
# nothing and `systemctl enable` has nothing to link; start it with `systemctl start tierstore`
# once the files below are in place.
#
# Edit before use: the listen address (192.0.2.10 is a documentation address), the proxy id (keep
# it across restarts, and give each process over the same tiers one of its own), the buckets, the
# endpoints (http://host[:port], no path) and --hot-bytes (the bytes the hot tier is meant to hold).
#
# Files on the host, owned by the account of User=, mode 0600; the flags that name them are the
# only way the process is given a secret (it reads no environment variable). Each holds one key
# as JSON, {"access_key_id": "...", "secret_access_key": "..."}, or as two lines (the access key
# id on the first, the secret access key on the second):
#   /etc/tierstore/access.key        the full key: it may do everything the server serves
#   /etc/tierstore/daemons.key       a read-only key, for the daemons that read blobs: it may get,
#                                    head and list, and every write or delete it signs is 403;
#                                    give --read-only-key-file once for each such key, each with
#                                    an access key id of its own
#   /etc/tierstore/hot.credentials   the key of the hot tier's store
#   /etc/tierstore/cold.credentials  the key of the cold tier's store
[Unit]
Description=tierstore, an S3 server over a hot and a cold tier
Documentation=https://github.com/komira-ai/kbf/blob/main/packaging/tierstore/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/tierstore/access.key
# Restart=on-failure below tries a start that failed again after RestartSec=30. The process itself
# asks a store that does not answer again for --backend-check-wait (5 minutes by default), so a
# store that is slow to come up after a reboot does not fail a start. A store that answers 500 for
# ever to a step the start-up self-test needs (a conditional put it does not support) fails every
# start with exit 1, as a store that is down does: after 5 starts in an hour (about half an hour
# of real failures, each start taking up to 5 minutes and a restart 30 s) systemd stops trying
# (`systemctl reset-failed tierstore` and a start try again), so that it does not loop for ever on
# a store that needs fixing.
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=simple
User=tierstore
ExecStart=/usr/libexec/kbf/tierstore \
  --listen 192.0.2.10:9000 \
  --proxy-id tierstore-1 \
  --bucket tierstore \
  --access-key-file /etc/tierstore/access.key \
  --read-only-key-file /etc/tierstore/daemons.key \
  --hot s3:tierstore-hot \
  --hot-endpoint http://s3-hot.example:9000 \
  --hot-credentials-file /etc/tierstore/hot.credentials \
  --hot-bytes 1099511627776 \
  --cold s3:tierstore-cold \
  --cold-endpoint http://s3-cold.example:9000 \
  --cold-credentials-file /etc/tierstore/cold.credentials \
  --drain-lb-wait 10s \
  --drain-deadline 15m
# On SIGTERM the process drains: /readyz says 503 and it serves for --drain-lb-wait, then stops
# accepting, closes idle connections and waits for those in flight for at most --drain-deadline, gives up the
# reconciler's lease (5 s at most) and exits 0. Seconds: 960 is the 10 s and the 15 m of the flags
# above and the lease, with a margin, so that systemd never sends SIGKILL to a drain in progress.
# Raise it with --drain-deadline.
KillSignal=SIGTERM
TimeoutStopSec=960
# A start that fails (a store that cannot be reached yet, an address in use) is tried again.
# Exit 2 is a command line the argument parser refused (an unknown flag, a missing or malformed
# value) or two keys with one access key id: a restart cannot mend it. Other flag combinations and
# key files refused after parsing exit 1 and are tried again every 30 s. Exit 3 is a tier that
# answered the start-up self-test wrongly (a store that overwrites on a create-only put, say): a
# restart would ask the same store the same questions, so it is not tried again. A tier that could
# not be reached exits 1 and is.
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2 3
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
